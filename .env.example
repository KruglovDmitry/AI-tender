# --- LLM ---
AI_TENDER_LLM_PROVIDER=deepseek
AI_TENDER_LLM_MODEL=deepseek-chat
# AI_TENDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI_TENDER_OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# --- Локальный LLM (vLLM / OpenAI-compatible в LAN) ---
# Индексация эталонов (VL) и опционально анализ тендера (AI_TENDER_LLM_PROVIDER=local).
# LOCAL_LLM_BASE_URL=http://10.127.0.41:8000
# LOCAL_LLM_DEFAULT_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
# LOCAL_LLM_ANALYSIS_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
# LOCAL_LLM_TIMEOUT_SEC=180
# LOCAL_LLM_MAX_OUTPUT_TOKENS=4096
# LOCAL_LLM_API_KEY=EMPTY
# AI_TENDER_LLM_PROVIDER=local

# --- LangGraph: файлы тендера ---
AI_TENDER_MAX_TENDER_FILES_INITIAL=3
AI_TENDER_MAX_TENDER_FILES_TOTAL=6
AI_TENDER_MAX_REQS_PER_SCOPE_ITEM=10
# AI_TENDER_MAX_REQUIREMENT_FILES=3
# AI_TENDER_REQUIREMENTS_PARALLELISM=6
# AI_TENDER_MATCH_PARALLELISM=4
# AI_TENDER_LLM_TRACE_ENABLED=true
# AI_TENDER_LLM_TRACE_DIR=data/llm_traces

# --- OCR (сканы PDF) ---
AI_TENDER_OCR_ENABLED=true
AI_TENDER_OCR_LANGUAGES=rus+eng

# --- Опционально ---
# AI_TENDER_EMBEDDING_MODEL=BAAI/bge-m3
# AI_TENDER_TOP_K=3
# AI_TENDER_CHUNK_SIZE=1024
# AI_TENDER_CHUNK_OVERLAP=128
# AI_TENDER_MAX_EXTRACT_CHARS_PER_DOC=120000
# AI_TENDER_CACHE_DIR=data/cache
# AI_TENDER_USER_INSTRUCTION=...
# UNRAR_TOOL=C:\Program Files\WinRAR\UnRAR.exe
# Linux: UNRAR_TOOL=/usr/bin/unrar  или  ~/.local/bin/unrar
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
