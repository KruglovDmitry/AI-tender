# --- LLM (match / verdict) ---
AI_TENDER_LLM_PROVIDER=qwen
AI_TENDER_LLM_MODEL=qwen-plus
# AI_TENDER_LLM_PROVIDER=deepseek
# AI_TENDER_LLM_MODEL=deepseek-chat
# AI_TENDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI_TENDER_OPENAI_BASE_URL=https://api.openai.com/v1
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# --- Whole-file извлечение (DashScope, отдельно от match) ---
AI_TENDER_EXTRACT_BACKEND=qwen
# DASHSCOPE_API_KEY=
# QWEN_API_KEY=
# AI_TENDER_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1  # intl (Singapore)
# AI_TENDER_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1       # China (Beijing)
# AI_TENDER_QWEN_DOC_MODEL=qwen-plus        # intl (Singapore); Beijing: qwen-doc-turbo или qwen-long
# AI_TENDER_QWEN_LONG_MODEL=qwen-long
# AI_TENDER_QWEN_EXTRACT_SCHEMA_VERSION=2

# --- LangGraph: файлы тендера ---
AI_TENDER_MAX_TENDER_FILES_INITIAL=3
AI_TENDER_MAX_TENDER_FILES_TOTAL=6
AI_TENDER_MAX_REQS_PER_SCOPE_ITEM=10
# AI_TENDER_MATCH_PARALLELISM=4
# AI_TENDER_LLM_TRACE_ENABLED=true
# AI_TENDER_LLM_TRACE_DIR=data/llm_traces

# --- OCR (сканы PDF) ---
AI_TENDER_OCR_ENABLED=true
AI_TENDER_OCR_LANGUAGES=rus+eng

# --- Опционально ---
# AI_TENDER_EMBEDDING_MODEL=BAAI/bge-m3
# AI_TENDER_TOP_K=3
# AI_TENDER_CACHE_DIR=data/cache
# AI_TENDER_USER_INSTRUCTION=...
# UNRAR_TOOL=C:\Program Files\WinRAR\UnRAR.exe
# Linux: UNRAR_TOOL=/usr/bin/unrar  или  ~/.local/bin/unrar
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
