# --- LLM ---
AI_TENDER_LLM_PROVIDER=deepseek
AI_TENDER_LLM_MODEL=deepseek-chat
# AI_TENDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI_TENDER_OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# --- LangGraph: файлы тендера ---
AI_TENDER_MAX_TENDER_FILES_INITIAL=3
AI_TENDER_MAX_TENDER_FILES_TOTAL=6
AI_TENDER_MAX_TENDER_QUERIES=15
AI_TENDER_MAX_FINDINGS=12
AI_TENDER_MAX_REQS_PER_SCOPE_ITEM=10

# --- OCR (сканы PDF) ---
AI_TENDER_OCR_ENABLED=true
AI_TENDER_OCR_LANGUAGES=rus+eng

